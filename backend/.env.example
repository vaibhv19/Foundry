# ==============================================================================
# Foundry — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to `backend/.env` and update the values as needed.

# ------------------------------------------------------------------------------
# Core Django settings
# ------------------------------------------------------------------------------
# Security Warning: Keep the secret key used in production secret!
# If left empty, Django will fall back to a safe auto-generated placeholder.
SECRET_KEY=django-insecure-your-secret-key-goes-here-make-sure-it-is-random

# Set to True for development/testing, False for production.
DEBUG=True

# Comma-separated list of host/domain names that this site can serve.
ALLOWED_HOSTS=localhost,127.0.0.1,*

# ------------------------------------------------------------------------------
# Database Settings
# ------------------------------------------------------------------------------
# Connection URI for the primary PostgreSQL or SQLite database.
# Default SQLite fallback: sqlite:///db.sqlite3
# Postgres (Docker Compose default): postgres://foundry_user:foundry_pass@db:5432/foundry
# Postgres (Local setup): postgres://foundry_user:foundry_pass@localhost:5432/foundry
DATABASE_URL=postgres://foundry_user:foundry_pass@db:5432/foundry

# ------------------------------------------------------------------------------
# Redis Settings
# ------------------------------------------------------------------------------
# Connection URI for the Redis cache / channel layer host.
# Local default: redis://127.0.0.1:6379/0
# Docker default: redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# Gemini API / LLM Service Settings
# ------------------------------------------------------------------------------
# Obtain your Gemini API Key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model used for agent debate nodes
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Celery background task settings
# ------------------------------------------------------------------------------
# Celery Broker URI (Redis db 0)
CELERY_BROKER_URL=redis://redis:6379/0

# Celery Result Backend URI (Redis db 1)
CELERY_RESULT_BACKEND=redis://redis:6379/1
